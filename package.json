{
  "name": "gladys-span-panel",
  "version": "0.1.1",
  "private": true,
  "description": "SPAN smart electrical panel for Gladys Assistant, through its official local API (eBus, MQTT): power and energy per circuit, grid, solar, battery, relay states, and opening or closing the circuit relays (off by default).",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-span-panel.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
